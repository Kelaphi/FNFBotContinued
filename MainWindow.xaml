<Window x:Class="FNFBot.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FNFBot 2.6" SizeToContent="WidthAndHeight"
        Icon="Resources/FNFBotIcon.ico"
        Background="#1d205d" Foreground="White"
        FontFamily="Consolas" ResizeMode="CanMinimize">

    <Window.Resources>
        <Style x:Key="NeonBtn" TargetType="Button">
            <Setter Property="Background" Value="#1d205d"/>
            <Setter Property="Foreground" Value="#ccccee"/>
            <Setter Property="BorderBrush" Value="#1d205d"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33005a"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#550080"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#555"/>
                                <Setter Property="BorderBrush" Value="#555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GreenBtn" TargetType="Button" BasedOn="{StaticResource NeonBtn}">
            <Setter Property="Foreground" Value="#55ff99"/>
            <Setter Property="BorderBrush" Value="#55ff99"/>
            <Setter Property="Background" Value="#001a0d"/>
        </Style>
        <Style x:Key="RedBtn" TargetType="Button" BasedOn="{StaticResource NeonBtn}">
            <Setter Property="Foreground" Value="#ff5555"/>
            <Setter Property="BorderBrush" Value="#ff5555"/>
            <Setter Property="Background" Value="#1a0000"/>
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#888"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#aaaacc"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="90"/>
        </Style>

        <Style x:Key="NumBox" TargetType="TextBox">
            <Setter Property="Width" Value="60"/>
            <Setter Property="Background" Value="#0d0d1a"/>
            <Setter Property="Foreground" Value="#ccccee"/>
            <Setter Property="BorderBrush" Value="#333366"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,2"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Width="480">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <Image Source="/Resources/FNFBotLogo.png" Height="50" VerticalAlignment="Center"/>
                <TextBlock Text="Continued" FontFamily="Arial" FontSize="35"
                           FontWeight="Normal" Foreground="#ffffff"
                           Margin="5,0,0,0" VerticalAlignment="Bottom"/>
            </StackPanel>

            <!-- Chart -->
            <Border Background="#05032f" BorderBrush="#333366"
                    BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="CHART" Style="{StaticResource SectionLabel}"/>
                    <DockPanel>
                        <Button Style="{StaticResource NeonBtn}" Content="Load JSON"
                                DockPanel.Dock="Right" Click="LoadChart_Click" Margin="8,0,0,0"/>
                        <TextBlock x:Name="ChartInfoText" Text="No chart loaded"
                                   Foreground="#ccccee" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Background="#05032f" BorderBrush="#333366"
                    BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button Style="{StaticResource NeonBtn}" Content="Reset"
                                DockPanel.Dock="Right" Click="ResetBindings_Click"/>
                        <TextBlock Text="KEYBINDS  (click a lane to rebind)"
                                   Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0"/>
                    </DockPanel>
                    <WrapPanel x:Name="BindingsPanel" Orientation="Horizontal"/>
                </StackPanel>
            </Border>

            <Border Background="#05032f" BorderBrush="#333366"
                    BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Offset (ms):" Style="{StaticResource FieldLabel}" Width="Auto" Margin="0,0,8,0"/>
                    <TextBox x:Name="OffsetBox" Style="{StaticResource NumBox}" Text="0"/>
                    <TextBlock Text="  (positive = press earlier, negative = press later)"
                               Foreground="#555" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="#05032f" BorderBrush="#333366"
                    BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Play as:" Style="{StaticResource FieldLabel}" Width="Auto" Margin="0,0,8,0"/>
                    <RadioButton x:Name="PlayerRight" Content="Right (Player)"
                                 Foreground="#ccccee" IsChecked="True"
                                 Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="PlayerLeft" Content="Left (Opponent)"
                                 Foreground="#ccccee"
                                 Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="PlayerBoth" Content="Both"
                                 Foreground="#ccccee"
                                 VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Border Background="#05032f" BorderBrush="#333366"
                    BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="DROP-IN MODE" Style="{StaticResource SectionLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="StartFromSong" Content="From song start"
                                     Foreground="#ccccee" IsChecked="True"
                                     Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <RadioButton x:Name="StartFromFirstNote" Content="From first note"
                                     Foreground="#ccccee" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="  'From first note' skips straight to the first note on the selected side"
                               Foreground="#555" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="#05032f" BorderBrush="#333366"
                    BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="HUMANISER" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Text="OFFSET RANGE (ms)  —  random deviation per note. 0,0 = perfect."
                               Foreground="#666" FontSize="10" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Min:" Foreground="#aaaacc" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBox x:Name="DevMinBox" TextChanged="Settings_Changed" Style="{StaticResource NumBox}" Text="0"/>
                        <TextBlock Text="   Max:" Foreground="#aaaacc" VerticalAlignment="Center" Margin="10,0,8,0"/>
                        <TextBox x:Name="DevMaxBox" TextChanged="Settings_Changed" Style="{StaticResource NumBox}" Text="0"/>
                        <TextBlock Text="  (negative = early, positive = late)"
                                   Foreground="#555" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>

                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="Miss %:" Style="{StaticResource FieldLabel}" Width="Auto" Margin="0,0,8,0"/>
                        <TextBox x:Name="MissPctBox" TextChanged="Settings_Changed" Style="{StaticResource NumBox}" Text="0"/>
                        <TextBlock Text="  chance each note is completely ignored"
                                   Foreground="#555" FontSize="11" VerticalAlignment="Center"/>
                    </DockPanel>

                    <TextBlock Text="TAP HOLD DURATION" Foreground="#888" FontSize="11" Margin="0,10,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Min (ms):" Style="{StaticResource FieldLabel}" Width="Auto" Margin="0,0,8,0"/>
                        <TextBox x:Name="HoldMinBox" TextChanged="Settings_Changed" Style="{StaticResource NumBox}" Text="0"/>
                        <TextBlock Text="   Max (ms):" Foreground="#aaaacc" VerticalAlignment="Center" Margin="10,0,8,0"/>
                        <TextBox x:Name="HoldMaxBox" TextChanged="Settings_Changed" Style="{StaticResource NumBox}" Text="0"/>
                        <TextBlock Text="  (adjust if it cant hit)"
                                   Foreground="#555" FontSize="11" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button x:Name="PlayBtn" Style="{StaticResource GreenBtn}"
                        Content="▶  START BOT" Width="140" Click="Play_Click"/>
                <Button x:Name="StopBtn" Style="{StaticResource RedBtn}"
                        Content="■  STOP" Width="100" Margin="10,0,0,0"
                        Click="Stop_Click" IsEnabled="False"/>
                <TextBlock x:Name="StatusText" Foreground="#ffff55"
                           VerticalAlignment="Center" Margin="14,0,0,0" FontSize="13"/>
            </StackPanel>

            <Border Background="#05032f" BorderBrush="#333366"
                    BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Text="HITS" Foreground="#55ffff" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="HitCount" Text="0" Foreground="#55ffff" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="MISS" Foreground="#888888" FontSize="11" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="MissCount" Text="0" Foreground="#888888" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>

        <Border Grid.Column="2" Background="#05032f" BorderBrush="#333366"
                BorderThickness="1" CornerRadius="4" Padding="6"
                VerticalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="LOG" Foreground="#555" FontSize="10" Margin="0,0,0,4"/>
                <ListBox x:Name="LogBox" Background="Transparent" BorderThickness="0"
                         Foreground="#99aacc" FontSize="11" Height="585"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" TextWrapping="Wrap"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </Border>

    </Grid>
</Window>